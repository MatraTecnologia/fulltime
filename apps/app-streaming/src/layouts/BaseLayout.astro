---
import "@/styles/globals.css"
interface Props { title: string }
const { title } = Astro.props
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-brand-navy antialiased">
    <slot />
  </body>
</html>
