---
import BaseLayout from "@/layouts/BaseLayout.astro"

interface Props {
  title: string
  heading?: string
  subheading?: string
}

const {
  title,
  heading = "Bem-vindo de volta",
  subheading = "Entre para continuar sua jornada de aprendizado.",
} = Astro.props

const destaques = [
  { titulo: "+500 aulas em vídeo", texto: "Conteúdo prático atualizado toda semana." },
  { titulo: "+12 mil profissionais", texto: "Uma comunidade que evolui junto com você." },
  { titulo: "Certificados reconhecidos", texto: "Comprove suas horas e progrida na carreira." },
  { titulo: "Aprendizado contínuo", texto: "Estude no seu ritmo, quando e onde quiser." },
]
---
<BaseLayout title={title}>
  <main class="grid min-h-screen lg:grid-cols-[1.05fr_1fr]">
    <aside class="relative hidden overflow-hidden bg-brand-navy text-white lg:flex lg:flex-col lg:justify-between lg:p-12 xl:p-16">
      <img
        src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1400&q=80"
        alt=""
        class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-20"
        loading="eager"
      />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-navy/95 to-brand-navy-900"></div>
      <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-blue/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-28 -left-16 h-80 w-80 rounded-full bg-brand-amber/10 blur-3xl"></div>

      <a href="/" class="auth-fade relative flex items-center gap-2.5">
        <img src="/icone.svg" alt="" class="h-9 w-auto brightness-0 invert" />
        <span class="font-display text-xl font-extrabold">Full <span class="text-brand-amber">Time</span></span>
      </a>

      <div class="relative max-w-md">
        <p class="auth-fade text-sm font-semibold uppercase tracking-widest text-brand-amber">Plataforma de formação</p>
        <h2 class="auth-rise mt-4 font-display text-4xl font-extrabold leading-[1.1] xl:text-[2.75rem]">
          Sua evolução profissional começa aqui.
        </h2>
        <ul class="mt-10 space-y-5">
          {destaques.map((d, i) => (
            <li class={`auth-rise flex items-start gap-3.5 auth-delay-${Math.min(i + 1, 3)}`}>
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-amber text-brand-navy">
                <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div>
                <p class="font-semibold leading-tight">{d.titulo}</p>
                <p class="mt-0.5 text-sm text-white/70">{d.texto}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <p class="auth-fade relative text-xs text-white/50">© 2026 Full Time · Formação continuada para profissionais da educação</p>
    </aside>

    <section class="flex items-center justify-center bg-surface px-4 py-10 sm:px-8">
      <div class="auth-rise w-full max-w-md">
        <div class="mb-8">
          <a href="/" class="mb-8 flex items-center gap-2.5 lg:hidden">
            <img src="/icone.svg" alt="" class="h-8 w-auto" />
            <span class="font-display text-lg font-extrabold text-brand-navy">Full <span class="text-brand-blue">Time</span></span>
          </a>
          <h1 class="font-display text-3xl font-extrabold tracking-tight text-brand-navy">{heading}</h1>
          <p class="mt-2 text-muted-foreground">{subheading}</p>
        </div>
        <slot />
      </div>
    </section>
  </main>
</BaseLayout>
