---
import BaseLayout from "@/layouts/BaseLayout.astro"
import { AppHeader } from "@/components/app/AppHeader.tsx"
import { PlayerRoot } from "@/components/player/PlayerRoot.tsx"
import type { CourseDetail, Lesson } from "@/lib/types"

const lesson = {
  id: 'l4', moduleId: 'm1', title: '1.4 Princípios da alfabetização inclusiva', order: 4,
  content: 'Nesta aula, você vai entender os principais princípios que norteiam a alfabetização inclusiva. Vamos explorar como adaptar o ensino para atender às necessidades de cada criança, promovendo um aprendizado significativo e acessível para todos.',
  transcript: null,
  videoSource: 'NONE', videoRef: null, durationSec: 605,
  attachments: [
    { id: 'a1', name: 'Slides de aula', url: 'https://example.com/s.pdf', type: 'PDF · 2.4 MB' },
    { id: 'a2', name: 'Guia prática: Princípios da alfabetização inclusiva', url: 'https://example.com/g.pdf', type: 'PDF · 1.8 MB' },
    { id: 'a3', name: 'Exemplos de adaptações', url: 'https://example.com/e.pdf', type: 'PDF · 3.1 MB' },
  ],
  video: { source: 'NONE', embedUrl: null, playbackId: null, token: null },
} as Lesson

const course = {
  id: 'c1', slug: 'alfabetizacao', title: 'Alfabetização Adaptada: Por Onde Começar',
  description: null, coverImage: null, status: 'PUBLISHED', instructor: { id: 'i1', name: 'João Lima' },
  modules: [
    { id: 'm1', title: 'Módulo 1 - Introdução', order: 1, lessons: [
      { id: 'l1', title: '1.1 Boas-vindas e apresentação do curso', order: 1, durationSec: 225 },
      { id: 'l2', title: '1.2 O que é alfabetização adaptada?', order: 2, durationSec: 492 },
      { id: 'l3', title: '1.3 A importância de adaptação no processo de alfabetização', order: 3, durationSec: 754 },
      { id: 'l4', title: '1.4 Princípios da alfabetização inclusiva', order: 4, durationSec: 605 },
      { id: 'l5', title: '1.5 Desafios mais comuns em sala de aula', order: 5, durationSec: 555 },
      { id: 'l6', title: '1.6 Estratégias iniciais para professores', order: 6, durationSec: 690 },
    ] },
    { id: 'm2', title: 'Módulo 2 - Fundamentos', order: 2, lessons: [{ id: 'l7', title: '2.1', order: 1, durationSec: 600 }] },
    { id: 'm3', title: 'Módulo 3 - Estratégias Práticas', order: 3, lessons: [{ id: 'l8', title: '3.1', order: 1, durationSec: 600 }] },
  ],
} as CourseDetail

const user = { id: 'u1', name: 'Ryan M. O. V.', email: '', role: 'profissional', image: null }
---
<BaseLayout title="preview">
  <AppHeader client:load user={user} />
  <PlayerRoot client:load course={course} enrollmentId="e1" initialCompleted={['l1', 'l2', 'l3', 'l4']} initialLessonId="l4" previewLesson={lesson} />
</BaseLayout>
