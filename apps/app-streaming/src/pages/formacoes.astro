---
import AppLayout from "@/layouts/AppLayout.astro"
import CourseCard from "@/components/home/CourseCard.astro"
import { apiServer } from "@/lib/api"
import type { CourseListItem, Category } from "@/lib/types"

const cookie = Astro.request.headers.get('cookie')
const activeCategory = Astro.url.searchParams.get('category')

const [courses, categories] = await Promise.all([
  apiServer<CourseListItem[]>('/courses' + (activeCategory ? '?category=' + activeCategory : ''), cookie).catch(() => []),
  apiServer<Category[]>('/categories', cookie).catch(() => []),
])
---
<AppLayout title="Formações — Full Time" user={Astro.locals.user}>
  <section class="mx-auto max-w-7xl px-6 py-10">
    <h1 class="font-display text-3xl font-extrabold text-brand-navy">Formações</h1>
    <p class="mt-2 text-sm text-muted-foreground">Explore os cursos disponíveis e encontre a formação certa para a sua prática profissional.</p>

    {categories.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        <a
          href="/formacoes"
          class={`rounded-pill px-4 py-2 text-sm font-semibold transition ${!activeCategory ? 'bg-brand-navy text-white' : 'bg-surface text-brand-navy hover:bg-brand-navy/10'}`}
        >
          Todas
        </a>
        {categories.map(cat => (
          <a
            href={`/formacoes?category=${cat.slug}`}
            class={`rounded-pill px-4 py-2 text-sm font-semibold transition ${activeCategory === cat.slug ? 'bg-brand-navy text-white' : 'bg-surface text-brand-navy hover:bg-brand-navy/10'}`}
          >
            {cat.name}
          </a>
        ))}
      </div>
    )}

    {courses.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {courses.map(c => <CourseCard course={c} />)}
      </div>
    ) : (
      <div class="mt-12 rounded-card bg-surface p-12 text-center">
        <p class="font-display text-lg font-bold text-brand-navy">Nenhuma formação por aqui ainda</p>
        <p class="mt-2 text-sm text-muted-foreground">Não encontramos cursos para esta seleção. Experimente outra categoria.</p>
      </div>
    )}
  </section>
</AppLayout>
