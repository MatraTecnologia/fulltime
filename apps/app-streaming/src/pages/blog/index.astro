---
import PublicLayout from "@/layouts/PublicLayout.astro"
import { apiServer } from "@/lib/api"
import type { PostListItem } from "@/lib/types"
import { formatDate } from "@/lib/format"

const cookie = Astro.request.headers.get('cookie')
const posts = await apiServer<PostListItem[]>('/posts', cookie).catch(() => [])
---
<PublicLayout title="Blog — Full Time">
  <section class="mx-auto max-w-6xl px-6 py-12">
    <header class="max-w-2xl">
      <span class="text-sm font-semibold text-brand-blue">Blog</span>
      <h1 class="mt-2 font-display text-4xl font-extrabold text-brand-navy">Conteúdos Full Time</h1>
      <p class="mt-3 text-brand-navy/60">Artigos sobre educação inclusiva, desenvolvimento infantil e a prática profissional com crianças atípicas.</p>
    </header>

    {posts.length === 0 ? (
      <p class="mt-12 text-brand-navy/50">Nenhum post publicado ainda.</p>
    ) : (
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map(p => (
          <a href={`/blog/${p.slug}`} class="group flex flex-col overflow-hidden rounded-card bg-white shadow-card transition hover:shadow-lifted">
            <div class="aspect-video w-full overflow-hidden bg-surface">
              {p.coverImage && <img src={p.coverImage} alt="" class="h-full w-full object-cover transition group-hover:scale-105" />}
            </div>
            <div class="flex flex-1 flex-col p-5">
              {p.categories[0] && <span class="text-xs font-semibold text-brand-blue">{p.categories[0].name}</span>}
              <h2 class="mt-1 font-display text-lg font-bold leading-snug text-brand-navy line-clamp-2">{p.title}</h2>
              {p.excerpt && <p class="mt-2 flex-1 text-sm leading-relaxed text-brand-navy/60 line-clamp-3">{p.excerpt}</p>}
              <div class="mt-4 flex items-center gap-2 text-xs text-brand-navy/50">
                <span class="font-medium">{p.author.name}</span>
                {p.publishedAt && <><span>·</span><span>{formatDate(p.publishedAt)}</span></>}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</PublicLayout>
