---
import BaseLayout from "@/layouts/BaseLayout.astro"
---
<BaseLayout title="Em manutenção — Full Time">
  <main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-brand-navy px-4 py-12 text-white sm:px-6">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-navy/95 to-brand-navy-900"></div>
    <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-blue/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-28 -left-16 h-80 w-80 rounded-full bg-brand-amber/10 blur-3xl"></div>

    <a href="/" class="auth-fade relative mb-10 flex items-center gap-2.5">
      <img src="/icone.svg" alt="" class="h-8 w-auto brightness-0 invert" />
      <span class="font-display text-lg font-extrabold">Full <span class="text-brand-amber">Time</span></span>
    </a>

    <div class="auth-rise relative w-full max-w-lg text-center">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-amber text-brand-navy shadow-lifted">
        <svg class="h-9 w-9" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M19.4 13a7.6 7.6 0 0 0 .06-1 7.6 7.6 0 0 0-.06-1l2.05-1.6a.5.5 0 0 0 .12-.64l-1.94-3.36a.5.5 0 0 0-.6-.22l-2.42.97a7.3 7.3 0 0 0-1.73-1l-.37-2.57a.5.5 0 0 0-.5-.42h-3.88a.5.5 0 0 0-.5.42l-.37 2.57a7.3 7.3 0 0 0-1.73 1l-2.42-.97a.5.5 0 0 0-.6.22L2.43 8.76a.5.5 0 0 0 .12.64L4.6 11a7.6 7.6 0 0 0 0 2l-2.05 1.6a.5.5 0 0 0-.12.64l1.94 3.36a.5.5 0 0 0 .6.22l2.42-.97a7.3 7.3 0 0 0 1.73 1l.37 2.57a.5.5 0 0 0 .5.42h3.88a.5.5 0 0 0 .5-.42l.37-2.57a7.3 7.3 0 0 0 1.73-1l2.42.97a.5.5 0 0 0 .6-.22l1.94-3.36a.5.5 0 0 0-.12-.64L19.4 13Z"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
          />
          <circle cx="12" cy="12" r="2.8" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </div>

      <p class="mt-8 text-sm font-semibold uppercase tracking-widest text-brand-amber">Full Time</p>
      <h1 class="mt-3 font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Estamos em manutenção</h1>
      <p class="mx-auto mt-4 max-w-md text-white/70">
        Estamos melhorando a plataforma. Voltamos em instantes — obrigado pela paciência.
      </p>

      <p class="mt-8 text-sm text-white/50">
        Precisa de ajuda?
        <a
          href="mailto:matratecnologia@gmail.com"
          class="font-semibold text-brand-amber underline-offset-4 transition hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-amber focus-visible:ring-offset-2 focus-visible:ring-offset-brand-navy"
        >
          matratecnologia@gmail.com
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
