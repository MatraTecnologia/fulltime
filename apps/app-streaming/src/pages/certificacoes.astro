---
import AppLayout from "@/layouts/AppLayout.astro"
import { apiServer } from "@/lib/api"
import type { CertificateItem } from "@/lib/types"

const cookie = Astro.request.headers.get('cookie')
const certificates = await apiServer<CertificateItem[]>('/certificates', cookie).catch(() => [])

const formatIssuedAt = (iso: string) =>
  new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(new Date(iso))
---
<AppLayout title="Certificações — Full Time" user={Astro.locals.user}>
  <section class="mx-auto max-w-7xl px-6 py-10">
    <h1 class="font-display text-3xl font-extrabold text-brand-navy">Meus Certificados</h1>
    <p class="mt-2 text-sm text-muted-foreground">Baixe e compartilhe os certificados das formações que você concluiu.</p>

    {certificates.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {certificates.map(cert => (
          <div class="flex flex-col overflow-hidden rounded-card bg-white shadow-card border-hairline">
            <div class="aspect-video bg-surface">
              {cert.course.coverImage && (
                <img src={cert.course.coverImage} alt={cert.course.title} class="h-full w-full object-cover" />
              )}
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="font-display text-base font-bold text-brand-navy line-clamp-2">{cert.course.title}</h3>
              <dl class="mt-3 space-y-1 text-xs text-muted-foreground">
                <div class="flex items-center justify-between gap-2">
                  <dt>Código</dt>
                  <dd class="font-mono font-semibold text-brand-navy">{cert.code}</dd>
                </div>
                <div class="flex items-center justify-between gap-2">
                  <dt>Emitido em</dt>
                  <dd class="font-semibold text-brand-navy">{formatIssuedAt(cert.issuedAt)}</dd>
                </div>
              </dl>
              <div class="mt-4 flex-1"></div>
              {cert.url ? (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-pill bg-brand-green px-4 py-2 text-sm font-semibold text-white transition hover:opacity-90"
                >
                  Baixar
                </a>
              ) : (
                <span class="inline-flex cursor-not-allowed items-center justify-center rounded-pill bg-surface px-4 py-2 text-sm font-semibold text-muted-foreground">
                  Em processamento
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-12 flex flex-col items-center rounded-card bg-surface p-12 text-center">
        <span class="text-5xl">🎓</span>
        <p class="mt-4 font-display text-lg font-bold text-brand-navy">Você ainda não tem certificados</p>
        <p class="mt-2 max-w-md text-sm text-muted-foreground">Conclua uma formação para receber seu certificado digital e comprovar suas horas de estudo.</p>
        <a
          href="/formacoes"
          class="mt-6 inline-flex items-center justify-center rounded-pill bg-brand-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90"
        >
          Explorar formações
        </a>
      </div>
    )}
  </section>
</AppLayout>
