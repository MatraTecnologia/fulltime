---
import AppLayout from "@/layouts/AppLayout.astro"
import CourseCard from "@/components/home/CourseCard.astro"
import { apiServer } from "@/lib/api"
import type { CategoryDetail } from "@/lib/types"

const { slug } = Astro.params
const cookie = Astro.request.headers.get('cookie')
const category = await apiServer<CategoryDetail>(`/categories/${slug}`, cookie).catch(() => null)
---
<AppLayout title={category ? `${category.name} — Full Time` : "Categoria — Full Time"} user={Astro.locals.user}>
  {!category ? (
    <section class="mx-auto max-w-3xl px-6 py-20 text-center">
      <h1 class="font-display text-2xl font-extrabold text-brand-navy">Categoria não encontrada</h1>
      <p class="mt-2 text-sm text-muted-foreground">A categoria que você procura não existe ou foi removida.</p>
      <a href="/categorias" class="mt-6 inline-flex items-center rounded-pill bg-brand-blue px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-blue-strong">
        Ver todas as categorias
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-6 py-10">
      <a href="/categorias" class="text-xs font-semibold text-brand-blue hover:underline">← Categorias</a>
      <div class="mt-3 flex items-start gap-4">
        <span
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-card bg-brand-blue text-2xl font-bold text-white"
          style={category.color ? `background-color:${category.color}` : ''}
        >
          {category.icon ?? '●'}
        </span>
        <div>
          <h1 class="font-display text-3xl font-extrabold text-brand-navy">{category.name}</h1>
          {category.description && <p class="mt-2 max-w-2xl text-sm text-muted-foreground">{category.description}</p>}
        </div>
      </div>

      {category.courses.length === 0 ? (
        <div class="mt-10 rounded-card bg-surface p-10 text-center">
          <p class="text-sm text-muted-foreground">Nenhum curso publicado nesta categoria por enquanto.</p>
        </div>
      ) : (
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {category.courses.map(course => <CourseCard course={course} />)}
        </div>
      )}
    </section>
  )}
</AppLayout>
