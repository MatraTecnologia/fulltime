---
import AppLayout from "@/layouts/AppLayout.astro"
import { apiServer } from "@/lib/api"
import type { Category } from "@/lib/types"

const cookie = Astro.request.headers.get('cookie')
const categories = await apiServer<Category[]>('/categories', cookie).catch(() => [])
---
<AppLayout title="Categorias — Full Time" user={Astro.locals.user}>
  <section class="mx-auto max-w-7xl px-6 py-10">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-wide text-brand-blue">Explorar</p>
      <h1 class="mt-1 font-display text-3xl font-extrabold text-brand-navy">Categorias</h1>
      <p class="mt-2 text-sm text-muted-foreground">Encontre conteúdos organizados por área de interesse e avance na sua prática profissional.</p>
    </div>

    {categories.length === 0 ? (
      <div class="mt-10 rounded-card bg-surface p-10 text-center">
        <p class="text-sm text-muted-foreground">Nenhuma categoria disponível no momento.</p>
      </div>
    ) : (
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map(c => (
          <a
            href={`/categorias/${c.slug}`}
            class="group flex flex-col rounded-card bg-white p-6 shadow-card transition hover:shadow-lifted"
          >
            <span
              class="flex h-12 w-12 items-center justify-center rounded-card bg-brand-blue text-xl font-bold text-white"
              style={c.color ? `background-color:${c.color}` : ''}
            >
              {c.icon ?? '●'}
            </span>
            <h2 class="mt-4 font-display text-lg font-extrabold text-brand-navy">{c.name}</h2>
            {c.description && <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{c.description}</p>}
            <span class="mt-4 inline-flex w-fit items-center rounded-pill bg-surface px-3 py-1 text-xs font-semibold text-brand-navy">
              {c._count?.courses ?? 0} {(c._count?.courses ?? 0) === 1 ? 'curso' : 'cursos'}
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</AppLayout>
