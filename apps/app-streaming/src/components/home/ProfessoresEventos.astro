---
// PLACEHOLDER: sem endpoint — dados mock, substituir quando houver API
const professores = [
  { nome: 'Dra. Maria Souza', especialidade: 'Especialista em Alfabetização Adaptada' },
  { nome: 'Prof. João Lima', especialidade: 'Especialista em Educação Inclusiva' },
  { nome: 'Dra. Ana Paula', especialidade: 'Neuropsicopedagoga' },
  { nome: 'Prof. Carlos Mendes', especialidade: 'Especialista em Gestão Escolar' },
]

const eventos = [
  { dia: '15', mes: 'AGO', tipo: 'Webinário', titulo: 'Estratégias para Crianças com TEA', meta: '20h00 · Online' },
  { dia: '22', mes: 'AGO', tipo: 'Live', titulo: 'Inclusão na Prática', meta: '19h00 · Online' },
  { dia: '05', mes: 'SET', tipo: 'Webinário', titulo: 'Neurodesenvolvimento', meta: '20h00 · Online' },
]

const beneficios = [
  { icone: '📜', titulo: '+50 horas certificadas', texto: 'Cursos reconhecidos e válidos para progressão de carreira.' },
  { icone: '🎓', titulo: 'Certificados digitais', texto: 'Receba seu certificado ao concluir cada formação.' },
  { icone: '♾️', titulo: 'Acesso ilimitado', texto: 'Estude quando e onde quiser, no seu próprio ritmo.' },
]
---
<section class="mx-auto max-w-7xl px-6 py-8">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <div class="flex flex-col rounded-card bg-white p-5 shadow-card">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-display text-lg font-extrabold text-brand-navy">Professores Destaque</h2>
          <p class="text-xs text-muted-foreground">Conheça nossos especialistas.</p>
        </div>
        <a href="#" class="text-xs font-semibold text-brand-blue hover:underline">Ver todos</a>
      </div>
      <ul class="mt-4 flex flex-1 flex-col gap-3">
        {professores.map(p => (
          <li class="flex items-center gap-3">
            <div class="h-10 w-10 shrink-0 rounded-full bg-surface"></div>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold text-brand-navy">{p.nome}</p>
              <p class="truncate text-xs text-muted-foreground">{p.especialidade}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col rounded-card bg-white p-5 shadow-card">
      <div class="flex items-start justify-between">
        <div>
          <h2 class="font-display text-lg font-extrabold text-brand-navy">Próximos Eventos e Webinários</h2>
          <p class="text-xs text-muted-foreground">Participe ao vivo e tire suas dúvidas.</p>
        </div>
        <a href="/eventos" class="text-xs font-semibold text-brand-blue hover:underline">Ver todos</a>
      </div>
      <ul class="mt-4 flex flex-1 flex-col gap-3">
        {eventos.map(e => (
          <li class="flex items-center gap-3">
            <div class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-lg bg-brand-navy-50 text-brand-navy">
              <span class="text-sm font-extrabold leading-none">{e.dia}</span>
              <span class="text-[10px] font-semibold leading-none">{e.mes}</span>
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-brand-navy">{e.tipo}: {e.titulo}</p>
              <p class="text-xs text-muted-foreground">{e.meta}</p>
            </div>
            <a href="/eventos" class="shrink-0 rounded-pill border border-brand-blue px-3 py-1 text-xs font-semibold text-brand-blue transition hover:bg-brand-blue hover:text-white">Inscrever-se</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative flex flex-col overflow-hidden rounded-card bg-white p-5 shadow-card">
      <h2 class="font-display text-lg font-extrabold text-brand-navy">Certificações e Benefícios</h2>
      <p class="text-xs text-muted-foreground">Invista no seu futuro.</p>
      <ul class="mt-4 flex flex-1 flex-col gap-4">
        {beneficios.map(b => (
          <li class="flex items-start gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-green/10 text-base">{b.icone}</span>
            <div>
              <p class="text-sm font-semibold text-brand-navy">{b.titulo}</p>
              <p class="text-xs text-muted-foreground">{b.texto}</p>
            </div>
          </li>
        ))}
      </ul>
      <span class="pointer-events-none absolute -bottom-4 -right-4 text-6xl opacity-10">🎓</span>
    </div>
  </div>
</section>
