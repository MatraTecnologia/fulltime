---
import type { CourseListItem } from "@/lib/types"
interface Props { course: CourseListItem | undefined }
const { course } = Astro.props
---
{course && (
  <section class="mx-auto max-w-7xl px-6 pt-6">
    <div class="relative flex min-h-[340px] items-center overflow-hidden sm:min-h-[440px]">
      {course.coverImage && (
        <img
          src={course.coverImage}
          alt=""
          class="banner-fade pointer-events-none absolute inset-0 h-full w-full object-cover"
        />
      )}
      {/* fade lateral pro fundo branco, garante leitura do texto à esquerda */}
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-white via-white/70 to-transparent"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent"></div>

      <div class="relative max-w-xl px-4 py-10 sm:px-8">
        <span class="inline-block rounded-pill bg-brand-blue px-3 py-1 text-xs font-semibold text-white">Em destaque</span>
        <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-brand-navy sm:text-4xl">{course.title}</h1>
        {course.description && (
          <p class="mt-3 max-w-md text-sm leading-relaxed text-brand-navy/70 line-clamp-3">{course.description}</p>
        )}
        <a
          href={`/aprender/${course.slug}`}
          class="mt-6 inline-block rounded-pill bg-brand-amber px-6 py-3 font-semibold text-brand-navy shadow-card transition hover:brightness-95"
        >
          Assistir agora
        </a>
      </div>
    </div>
  </section>
)}
