---
// PLACEHOLDER: sem endpoint — dados mock, substituir quando houver API
const depoimentos = [
  { nome: 'Juliana Martins', papel: 'Profissional', texto: 'A plataforma transformou minha prática pedagógica e os conteúdos são aplicáveis e os professores excelentes!' },
]
const destaque = depoimentos[0]
---
<div class="flex h-full flex-col rounded-card bg-brand-purple p-5 text-white shadow-card">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="font-display text-lg font-extrabold">O que nossos alunos dizem</h2>
      <p class="text-xs text-white/80">Histórias reais de transformação profissional.</p>
    </div>
    <a href="#" class="text-xs font-semibold text-white hover:underline">Ver todos</a>
  </div>
  <div class="mt-4 flex flex-1 flex-col justify-center rounded-card bg-white p-4 text-brand-navy shadow-card">
    <p class="text-sm italic text-muted-foreground">"{destaque.texto}"</p>
    <div class="mt-3 flex items-center gap-3">
      <div class="h-9 w-9 shrink-0 rounded-full bg-surface"></div>
      <div>
        <p class="text-sm font-semibold text-brand-navy">{destaque.nome}</p>
        <p class="text-xs text-muted-foreground">{destaque.papel}</p>
      </div>
      <div class="ml-auto flex gap-0.5 text-brand-amber">
        {Array.from({ length: 5 }).map(() => (
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.5 5.9.6-4.4 4 1.2 5.9L10 14.7l-5.3 2.8 1.2-5.9-4.4-4 5.9-.6z"/></svg>
        ))}
      </div>
    </div>
  </div>
</div>
