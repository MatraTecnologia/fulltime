---
// PLACEHOLDER: sem endpoint — dados mock, substituir quando houver API
const navegacao = [
  { label: 'Início', href: '/' },
  { label: 'Formações', href: '#' },
  { label: 'Trilhas', href: '#' },
  { label: 'Categorias', href: '#' },
  { label: 'Eventos', href: '#' },
]
const institucional = [
  { label: 'Sobre nós', href: '#' },
  { label: 'Blog', href: '#' },
  { label: 'Carreiras', href: '#' },
  { label: 'Parceiros', href: '#' },
  { label: 'Contato', href: '#' },
]
const suporte = [
  { label: 'Central de Ajuda', href: '#' },
  { label: 'Fale Conosco', href: '#' },
  { label: 'Política de Privacidade', href: '#' },
  { label: 'Termos de Uso', href: '#' },
]
const redes = ['📷', '📘', '▶️', '💼']
const ano = new Date().getFullYear()
---
<footer class="bg-brand-navy text-white">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <span class="font-display text-lg font-extrabold">Full Time</span>
        <p class="mt-2 max-w-xs text-sm text-white/70">Transformando a educação através do conhecimento e da prática.</p>
        <div class="mt-4 flex gap-3">
          {redes.map(r => (
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 text-sm">{r}</span>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-white">Navegação</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {navegacao.map(n => <li><a href={n.href} class="text-sm text-white/70 hover:text-white">{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-white">Institucional</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {institucional.map(n => <li><a href={n.href} class="text-sm text-white/70 hover:text-white">{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-white">Suporte</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {suporte.map(n => <li><a href={n.href} class="text-sm text-white/70 hover:text-white">{n.label}</a></li>)}
        </ul>
        <h3 class="mt-6 text-sm font-semibold text-white">Newsletter</h3>
        <p class="mt-2 text-sm text-white/70">Receba novidades e conteúdos exclusivos.</p>
        <form class="mt-3 flex gap-2">
          <input type="email" placeholder="Seu melhor e-mail" class="w-full min-w-0 rounded-pill border border-white/20 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/50 focus:outline-none" />
          <button type="submit" class="shrink-0 rounded-pill bg-brand-blue px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-blue-strong">Inscrever-se</button>
        </form>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-4 text-center text-xs text-white/60">
      © {ano} Full Time. Todos os direitos reservados.
    </div>
  </div>
</footer>
